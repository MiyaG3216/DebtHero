  m_EditorClassIdentifier: Assembly-CSharp::StoryScenarioManager
  _scenarioList:
  - EventName: "\u30AA\u30FC\u30D7\u30CB\u30F3\u30B0"
    Timing: 0
    TargetStageIndex: 0
    EnemyPortrait: {fileID: 21300000, guid: 259a9112fb4a1bf4a92cffb04f46847e, type: 3}
    BackgroundImage: {fileID: 21300000, guid: 1fb106a02d81e6446b236831e539ac24, type: 3}
    Lines:
    - SpeakerName: "\u3057\u305F\u3063\u3071"
      Message: "\u304A\u3044\u304A\u3044\u3001\u5F85\u3061\u308F\u3073\u305F\u305C\u501F\u91D1\u91CE\u90CE\uFF01\\n\u8033\u3092\u305D\u308D\u3048\u3066\u8FD4\u3057\u3066\u3082\u3089\u304A\u3046\u304B\u3041\uFF01\uFF1F"
      TriggerEnemyDamage: 0
    - SpeakerName: "\u4E3B\u4EBA\u516C"
      Message: "\uFF08\u8EAB\u306B\u899A\u3048\u306E\u306A\u3044\u83AB\u5927\u306A\u501F\u91D1\u2026\uFF01\uFF1F\\n\u3060\u304C\u3053\u306E\u8857\u306E\u639F\u306F\u30C0\u30A4\u30B9\u30B2\u30FC\u30E0\u306E\u5F37\u3055\u304C\u5168\u3066\u3060\uFF01\uFF09"
      TriggerEnemyDamage: 0
    - SpeakerName: "\u4E3B\u4EBA\u516C"
      Message: "\u91D1\u306A\u3089\u30C0\u30A4\u30B9\u3067\u7A3C\u3044\u3067\u3084\u308B\uFF01\\n\u3066\u3081\u3047\u306E\u30DC\u30B9\u304C\u3044\u308B\u672C\u793E\u307E\u3067\u30AB\u30C1\u30B3\u30DF\u3060\uFF01\uFF01"
      TriggerEnemyDamage: 0
  - EventName: "\u3057\u305F\u3063\u3071\u6483\u9000"
    Timing: 2
    TargetStageIndex: 0
    EnemyPortrait: {fileID: 21300000, guid: 259a9112fb4a1bf4a92cffb04f46847e, type: 3}
    BackgroundImage: {fileID: 21300000, guid: 1fb106a02d81e6446b236831e539ac24, type: 3}
    Lines:
    - SpeakerName: "\u3057\u305F\u3063\u3071"
      Message: "\u3050\u308F\u3041\u30FC\u30FC\uFF01\uFF1F\\n\u306A\u3001\u306A\u3093\u3060\u3053\u306E\u5F37\u3055\u306F\u3041\u30FC\u30FC\uFF01\uFF1F"
      TriggerEnemyDamage: 1
    - SpeakerName: "\u4E3B\u4EBA\u516C"
      Message: "\u3078\u3063\u3001\u53E3\u307B\u3069\u306B\u3082\u306D\u3048\u306A\u3002\\n\u5DFB\u304D\u4E0A\u3052\u305F\u91D1\u3067\u30C0\u30A4\u30B9\u3092\u5F37\u5316\u3057\u3066\u6B21\u3078\u9032\u3080\u305E\uFF01"
      TriggerEnemyDamage: 0
  - EventName: "\u30A2\u30CB\u30AD\u767B\u5834"
    Timing: 1
    TargetStageIndex: 1
    EnemyPortrait: {fileID: 21300000, guid: ece2d0459038cc540aa80b141ec65ced, type: 3}
    BackgroundImage: {fileID: 21300000, guid: 1fb106a02d81e6446b236831e539ac24, type: 3}
    Lines:
    - SpeakerName: "\u30A2\u30CB\u30AD"
      Message: "\u3057\u305F\u3063\u3071\u304C\u4E16\u8A71\u306B\u306A\u3063\u305F\u3088\u3046\u3060\u306A\u2026\u2026\u3002\\n\u3060\u304C\u30EF\u30B7\u306E\u53D6\u308A\u7ACB\u3066\u306F\u7518\u304F\u306A\u3044\u305E\u3001\u5C0F\u50E7\u3002"
      TriggerEnemyDamage: 0
  - EventName: "\u30A2\u30CB\u30AD\u6483\u9000"
    Timing: 2
    TargetStageIndex: 1
    EnemyPortrait: {fileID: 21300000, guid: ece2d0459038cc540aa80b141ec65ced, type: 3}
    BackgroundImage: {fileID: 21300000, guid: 1fb106a02d81e6446b236831e539ac24, type: 3}
    Lines:
    - SpeakerName: "\u30A2\u30CB\u30AD"
      Message: "\u30D0\u3001\u30D0\u30AB\u306A\u2026\u2026\uFF01\\n\u3053\u306E\u30EF\u30B7\u304C\u30C0\u30A4\u30B9\u52DD\u8CA0\u3067\u8CA0\u3051\u308B\u3060\u3068\u2026\u2026\uFF01\uFF1F"
      TriggerEnemyDamage: 1
    - SpeakerName: "\u4E3B\u4EBA\u516C"
      Message: "\u3088\u3057\u3001\u3053\u306E\u5148\u306B\u306F\u88CF\u30AB\u30B8\u30CE\u30B7\u30E7\u30C3\u30D7\u304C\u3042\u308B\u306A\u3002\\n\u30A4\u30AB\u30B5\u30DE\u30C0\u30A4\u30B9\u3092\u4ED5\u5165\u308C\u3066\u4E2D\u30DC\u30B9\u306B\u5099\u3048\u3088\u3046\uFF01"
